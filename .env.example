# Replace with your Home Assistant's actual LAN IP address (not .local hostname)
HA_BASE_URL=http://192.168.1.100:8123
HA_TOKEN=your-long-lived-access-token
# Required outside the Home Assistant add-on: it is the only way to reach admin
# and create the first portal. Each portal's guest password is set in the UI.
ADMIN_PASSWORD=CHANGE-ME-admin-password
PORT=9123
DB_PATH=/data/portal.db
# TRUST_PROXY=loopback
