{
  "name": "ha-guest-portal",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5173 & node --watch --experimental-strip-types src/server/index.ts",
    "dev:fake-ha": "node --experimental-strip-types scripts/dev-fake-ha.ts",
    "dev:demo": "./scripts/dev-demo.sh",
    "themes:css": "tsx scripts/generate-theme-css.ts",
    "dev:real": "HA_MODE=real ./scripts/dev-demo.sh",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "previews:update": "pnpm build && playwright test -g \"preview:\" --update-snapshots",
    "previews:update:ci": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/w -w /w mcr.microsoft.com/playwright:v1.63.0-noble sh -c 'mkdir -p /tmp/bin && corepack enable --install-directory /tmp/bin && export PATH=/tmp/bin:$PATH && pnpm install --frozen-lockfile && pnpm build && pnpm exec playwright test -g \"preview:\" --update-snapshots'",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@mdi/js": "^7.4.47",
    "hono": "^4.7.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.1"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.4",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
